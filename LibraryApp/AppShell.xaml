<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="LibraryApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:LibraryApp.Views"
    Title="Библиотека"
    BackgroundColor="{StaticResource Background}"
    FlyoutBehavior="Disabled"
    ForegroundColor="{StaticResource Primary}"
    NavBarHasShadow="False"
    Shell.TabBarIsVisible="False"
    TitleColor="{StaticResource TextPrimary}">

    <ShellContent
        Title="Библиотека"
        ContentTemplate="{DataTemplate views:BooksPage}"
        Route="BooksPage" />
</Shell>
